#Data Cleansing
# removing the duplicates
# For missing values, we add mean value. 
# this dataset didn't have any missing values but this function will take care of handling missing values if the dataset gets changed in future.
def data_cleansing(data):
    if data.duplicated().sum() > 0:
        data.drop_duplicates(inplace=True)
        modifiedDf = data
    
    
    elif data.isna().sum().any() > 0:  
        # Separate numeric and non-numeric columns
        numeric_cols = data.select_dtypes(include=[np.number]).columns
        non_numeric_cols = data.select_dtypes(exclude=[np.number]).columns

        # Fill missing values in numeric columns with the mean
        data.loc[:, numeric_cols].fillna(data[numeric_cols].mean(), inplace=True)
        
        # Fill missing values in non-numeric columns with most frequent value
        data.loc[:, non_numeric_cols].fillna(data[non_numeric_cols].mode().iloc[0], inplace=True)
        
        modifiedDf = data  
    
    else:
        modifiedDf = data  
    
    return modifiedDf  

