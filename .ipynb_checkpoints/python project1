# Number of promotions in the last 5 years over different departments
def aggFunc2(df):
    print("Number of promotions in the last 5 years over different departments")
    grouped_data = df[['Department','Job_Title','Gender','Promotion_Last_5Years','Salary']]
    grouped_data = grouped_data.groupby(['Department','Job_Title','Gender']).agg(Total_promotions=('Promotion_Last_5Years','sum'),Number_of_employees=('Salary','count'))
    grouped_data['Percentage_of_Promotions'] = (grouped_data['Total_promotions']/grouped_data['Number_of_employees'])*100
    grouped_data['Percentage_of_Promotions'] =    grouped_data['Percentage_of_Promotions'].round(2)
    return grouped_data
    
print(aggFunc2(df))

#Correlation
#  employee attritions based on promotion status
def count_attrition(group, promoted):
    return ((group['Attrition'] == 1) & (group['Promotion_Last_5Years'] == promoted)).sum()

# Aggregation function to calculate attrition counts based on promotion status
def attrition_by_promotion_status(df, promoted):
    promotion_status = "before" if promoted == 0 else "after"
    print(f"Number of employee attrition {promotion_status} promotion")
    
    #   group data
    grouped_data = df[['Department', 'Gender',  'Attrition', 'Promotion_Last_5Years']]
    grouped_data = grouped_data.groupby(['Department', 'Gender'])
    
    # Apply the counting function and reset the index
    grouped_data = grouped_data.apply(lambda group: count_attrition(group, promoted)).reset_index(name='Req_count')
    return grouped_data

# attrition before promotion
attrition_before_promotion = attrition_by_promotion_status(df, promoted=0)
print(attrition_before_promotion)
#attrition after promotion
attrition_after_promotion = attrition_by_promotion_status(df, promoted=1)

print(attrition_after_promotion)

