#Calculating summary statistics
def summarize_statistics(df):
    """
    Calculate and print summary statistics for each column in the given DataFrame.
    
    Parameters:
    df (pd.DataFrame): The DataFrame to analyze.
    
    Returns:
    pd.DataFrame: A DataFrame containing the summary statistics.
    """
    # Ensure input is a DataFrame
    if not isinstance(df, pd.DataFrame):
        raise ValueError("Input must be a Pandas DataFrame")

    # Create a dictionary to hold the statistics
    summary = {
        "Mean": df.mean(),
        "Median": df.median(),
        "Standard Deviation": df.std(),
        "Minimum": df.min(),
        "Maximum": df.max(),
        "25th Percentile": df.quantile(0.25),
        "50th Percentile": df.quantile(0.50),
        "75th Percentile": df.quantile(0.75),
        "Count": df.count()
    }
    
    # Create a DataFrame from the dictionary
    summary_df = pd.DataFrame(summary)
    
    return summary_df

